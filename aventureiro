# include <stdio.h>

#define TamLinha 10
#define Tamcoluna 10
#define TamNavio 3

int main (){
 // tabuleiro deve ser 10x10
 int tabuleiro [TamLinha][Tamcoluna];

 //iniciando o tabuleiro com 0 (água)

 for(int linha = 0; linha < TamLinha; linha++){
  for(int coluna = 0; coluna < Tamcoluna; coluna++){
    tabuleiro [linha][coluna] = 0;
  }

 }
  // Posicionando os 4 navios
  // Navio horizontal
    for (int linha = 0; linha < TamNavio; linha++) {
        tabuleiro[1][2 + linha] = 3;
    }

    // Navio vertical
    for (int coluna = 0; coluna < TamNavio; coluna++) {
        tabuleiro[5 + coluna][0] = 3;
    }

    // Navio diagonal principal (↘)
    for (int linha = 0; linha < TamNavio; linha++) {
        tabuleiro[linha][7 + linha] = 3;
    }

    // Navio diagonal secundária (↙)
    for (int coluna = 0; coluna < TamNavio; coluna++) {
        tabuleiro[7 + coluna][9 - coluna] = 3;
    }


    printf("\n***Tabuleiro Batalha Naval***\n\n");

     printf("   ");

     // Loop que usa caracteres para representar as colunas de A a J.
 
    for (char letra = 'A'; letra <= 'J'; letra++)
    {
        // Imprime a letra seguida de um espaço para formatação.
        printf("%c ", letra);
    }

    // Pula para a próxima linha após imprimir todas as letras.
    printf("\n");

    // Área de Impressão Das Linhas Do Tabuleiro.
    
    for (int linha = 0; linha < 10; linha++)
    {

        // Imprime o número da linha com formatação de 2 dígitos (ex: " 1", " 2", ..., "10").
        // linha + 1 porque o usuário vê de 1 a 10, mas a matriz usa 0 a 9.
        printf("%2d ", linha + 1);

          for (int coluna = 0; coluna < 10; coluna++)
        {
            printf("%d ", tabuleiro [linha] [coluna]);
        }

        // Pula para a próxima linha após imprimir todas as colunas da linha atual.
        printf("\n");
    }
   

  return 0;
}
